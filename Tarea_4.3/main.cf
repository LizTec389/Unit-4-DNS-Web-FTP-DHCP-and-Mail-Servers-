# ── CONFIGURACIÓN GENERAL ─────────────────────────────
compatibility_level = 3.6
biff = no
append_dot_mydomain = no
readme_directory = no

# ── IDENTIDAD DEL SERVIDOR ────────────────────────────
myhostname = mail.empresa.local
mydomain = empresa.local
myorigin = /etc/mailname

# ── RED ───────────────────────────────────────────────
inet_interfaces = all
inet_protocols = ipv4

# ── DESTINOS LOCALES ──────────────────────────────────
mydestination = $myhostname, empresa.local, localhost.empresa.local, localhost

# ── ALIASES ───────────────────────────────────────────
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
recipient_delimiter = +

# ── RELAY ─────────────────────────────────────────────
mynetworks = 127.0.0.0/8 192.168.100.0/24
relayhost =

# ── BUZONES ───────────────────────────────────────────
home_mailbox = Maildir/
mailbox_size_limit = 51200000
message_size_limit = 10240000

# ── BANNER ────────────────────────────────────────────
smtpd_banner = $myhostname ESMTP Servidor Corporativo

# ── TLS PARA SMTP ─────────────────────────────────────
smtpd_tls_cert_file = /etc/apache2/ssl/empresa.local.crt
smtpd_tls_key_file = /etc/apache2/ssl/empresa.local.key
smtpd_use_tls = yes
smtpd_tls_security_level = may
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_CApath = /etc/ssl/certs
smtp_tls_security_level = may
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# ── RESTRICCIONES ANTI-SPAM ───────────────────────────
smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
