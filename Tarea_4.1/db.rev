$TTL    604800
@       IN      SOA     ns1.empresa.local. admin.empresa.local. (
                              2         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
; Servidor de Nombres (NS)
@       IN      NS      ns1.empresa.local.

; Registros tipo PTR (Punteros inversos)
10      IN      PTR     ns1.empresa.local.
15      IN      PTR     mail.empresa.local.
200     IN      PTR     impresora.empresa.local.
